<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>sarto-app-pom</artifactId>
    <version>${revision}</version>
    <relativePath>../sarto-app-pom/pom.xml</relativePath>
  </parent>

  <artifactId>sarto-app-cloudflare-pom</artifactId>
  <packaging>pom</packaging>
  <name>Sarto application parent — Cloudflare host</name>
  <description>Cloudflare host build, staging and deployment conventions layered on the portable Sarto application parent</description>

  <!-- ── Role ────────────────────────────────────────────────────────────
       Hosting parent for an application deployed to Cloudflare Workers or Pages.

       Provides  The Cloudflare staging directories, worker script and
                 compatibility date, the wrangler and Node versions, the
                 Cloudflare edge runtime and CDI dependencies, and the
                 stage-pages, stage-local and publish-cloudflare profiles.
       Requires  Everything sarto-app-pom requires. A project sets
                 cloudflare.pages.projectName and the worker script name.
  -->

  <properties>
    <cloudflare.pages.stageDirectory>${project.build.directory}/cloudflare-pages</cloudflare.pages.stageDirectory>
    <cloudflare.assets.stageDirectory>${cloudflare.pages.stageDirectory}/assets</cloudflare.assets.stageDirectory>
    <cloudflare.pages.projectName>${project.artifactId}</cloudflare.pages.projectName>
    <cloudflare.wrangler.version>latest</cloudflare.wrangler.version>
    <cloudflare.worker.script>${project.build.directory}/cloudflare-worker.js</cloudflare.worker.script>
    <cloudflare.worker.config>${project.build.directory}/wrangler.jsonc</cloudflare.worker.config>
    <cloudflare.worker.compatibilityDate>2026-05-08</cloudflare.worker.compatibilityDate>
    <node.version>v22.11.0</node.version>
    <npm.version>10.9.0</npm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-edge-cf-persistence-keyvalue</artifactId>
        <version>${sarto-edge.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-edge-cf-persistence-d1</artifactId>
        <version>${sarto-edge.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-cdi-teavm-tooling</artifactId>
      <version>${sarto-cdi.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-edge-cf-jso</artifactId>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-edge-cf-cdi</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>sarto-edge-cf-cdi-codegen</artifactId>
              <version>${sarto-edge.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-edge-cf-maven-plugin</artifactId>
          <version>${sarto-edge.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>stage-pages</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>require-cloudflare-stage-path</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <rules>
                    <requireProperty>
                      <property>cloudflare.pages.stagePath</property>
                      <message>Set cloudflare.pages.stagePath before staging a Sarto app for Cloudflare.</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>stage-cloudflare-assets</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <target>
                    <delete dir="${cloudflare.pages.stageDirectory}"/>
                    <mkdir dir="${cloudflare.assets.stageDirectory}/${cloudflare.pages.stagePath}"/>
                    <copy todir="${cloudflare.assets.stageDirectory}/${cloudflare.pages.stagePath}">
                      <fileset dir="${app.teavm.target.directory}">
                        <exclude name="**/*.js.map"/>
                        <exclude name="src/**"/>
                      </fileset>
                    </copy>
                    <echo file="${cloudflare.worker.script}"
                          message="export default {&#10;  async fetch(request, env) {&#10;    return env.ASSETS.fetch(request);&#10;  }&#10;};&#10;"/>
                    <echo file="${cloudflare.worker.config}"
                          message="{&#10;  &quot;name&quot;: &quot;${cloudflare.pages.projectName}&quot;,&#10;  &quot;compatibility_date&quot;: &quot;${cloudflare.worker.compatibilityDate}&quot;,&#10;  &quot;main&quot;: &quot;${cloudflare.worker.script}&quot;,&#10;  &quot;assets&quot;: {&#10;    &quot;directory&quot;: &quot;${cloudflare.assets.stageDirectory}&quot;,&#10;    &quot;binding&quot;: &quot;ASSETS&quot;&#10;  }&#10;}&#10;"/>
                    <echo message="Staged Cloudflare assets at ${cloudflare.assets.stageDirectory}/${cloudflare.pages.stagePath}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>stage-pages-source-maps</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>stage-cloudflare-source-maps</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <target>
                    <copy todir="${cloudflare.assets.stageDirectory}/${cloudflare.pages.stagePath}" overwrite="true">
                      <fileset dir="${app.teavm.target.directory}">
                        <include name="${app.teavm.target.file}"/>
                        <include name="${app.teavm.target.file}.map"/>
                        <include name="src/**"/>
                      </fileset>
                    </copy>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>stage-local</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>stage-local-cloudflare-assets</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <target>
                    <delete dir="${cloudflare.pages.stageDirectory}"/>
                    <mkdir dir="${cloudflare.pages.stageDirectory}/${cloudflare.pages.stagePath}"/>
                    <copy todir="${cloudflare.pages.stageDirectory}/${cloudflare.pages.stagePath}">
                      <fileset dir="${app.teavm.target.directory}"/>
                    </copy>
                    <echo message="Serving ${cloudflare.pages.stageDirectory} on port ${app.server.port}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>serve-local-cloudflare-assets</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <executable>${app.jvm.java}</executable>
                  <commandlineArgs>-m jdk.httpserver -p ${app.server.port} -d ${cloudflare.pages.stageDirectory}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>publish-cloudflare</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>require-cloudflare-publish-settings</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <rules>
                    <requireProperty><property>cloudflare.accountId</property></requireProperty>
                    <requireProperty><property>cloudflare.apiToken</property></requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <version>2.0.1</version>
            <configuration><installDirectory>${project.build.directory}/node</installDirectory></configuration>
            <executions>
              <execution>
                <id>install-cloudflare-node-tooling</id>
                <phase>validate</phase>
                <goals><goal>install-node-and-npm</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <nodeVersion>${node.version}</nodeVersion>
                  <npmVersion>${npm.version}</npmVersion>
                </configuration>
              </execution>
              <execution>
                <id>deploy-cloudflare-worker</id>
                <phase>deploy</phase>
                <goals><goal>npm</goal></goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <arguments>exec --yes --package=wrangler@${cloudflare.wrangler.version} -- wrangler deploy --config ${cloudflare.worker.config}</arguments>
                  <environmentVariables>
                    <CLOUDFLARE_ACCOUNT_ID>${cloudflare.accountId}</CLOUDFLARE_ACCOUNT_ID>
                    <CLOUDFLARE_API_TOKEN>${cloudflare.apiToken}</CLOUDFLARE_API_TOKEN>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
