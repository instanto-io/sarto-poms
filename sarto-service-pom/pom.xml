<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>sarto-entity-model-pom</artifactId>
    <version>${revision}</version>
    <relativePath>../sarto-entity-model-pom/pom.xml</relativePath>
  </parent>

  <artifactId>sarto-service-pom</artifactId>
  <packaging>pom</packaging>
  <name>sarto-service-pom</name>

  <!-- ── Role ────────────────────────────────────────────────────────────
       Parent for server-side service modules. It extends the entity model parent
       with the RPC and coordination surface a service needs.

       Provides  The Sarto core, RPC, bootstrap, coordination and app
                 dependencies; the servlet and JAX-WS APIs; the component-jre,
                 component-teavm and component-teavm-worker profiles; a
                 runtime-neutral enforcer run.
       Requires  Everything sarto-entity-model-pom requires.
       Not here  Application packaging or a hosting target.
  -->

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-core</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-rpc</artifactId>
      <version>${revision}</version>
    </dependency>
    <!-- Required for codegen-generated _ContractAdapter and GeneratedAppManifest -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-bootstrap</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-coordination</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-app</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Standard unit-of-work declaration; the final host supplies execution. -->
    <dependency>
      <groupId>jakarta.transaction</groupId>
      <artifactId>jakarta.transaction-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.jws</groupId>
      <artifactId>jakarta.jws-api</artifactId>
      <version>3.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.xml.ws</groupId>
      <artifactId>jakarta.xml.ws-api</artifactId>
      <version>4.0.3</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>attach-client-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>client</classifier>
              <includes>
                <include>**/service/**</include>
                <include>**/services/**</include>
                <include>**/dto/**</include>
                <include>**/entity/**</include>
                <include>**/event/**</include>
                <include>**/events/**</include>
                <include>**/*_Stub.class</include>
                <include>**/*_Codec.class</include>
                <include>**/*_Factory.class</include>
                <include>META-INF/middleware/proto/**</include>
              </includes>
              <excludes>
                <exclude>**/impl/**</exclude>
                <exclude>**/*Impl.class</exclude>
                <exclude>**/*Impl_*.class</exclude>
                <exclude>**/*Dispatcher.class</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-maven-plugin</artifactId>
          <version>${teavm.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.teavm</groupId>
              <artifactId>teavm-extras-slf4j</artifactId>
              <version>${teavm.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <transformers>
              <transformer>io.instanto.sarto.cdi.teavm.JvmTargetPruningTransformer</transformer>
            </transformers>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>runtime-neutral-enforcer</id>
      <activation>
        <property>
          <name>runtime.neutral</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>ban-runtime-classifier-dependencies</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <bannedDependencies>
                      <searchTransitive>true</searchTransitive>
                      <excludes>
                        <exclude>*:*:*:*:*:jre</exclude>
                        <exclude>*:*:*:*:*:teavm</exclude>
                      </excludes>
                      <message>Runtime-neutral modules must not depend on jre/teavm classified artifacts.</message>
                    </bannedDependencies>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>component-jre</id>
      <activation>
        <file>
          <exists>src/jre/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-jre-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/jre/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>attach-jre-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>jre</classifier>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>component-teavm</id>
      <activation>
        <file>
          <exists>src/teavm/java</exists>
        </file>
      </activation>
      <properties>
        <app.teavm.main.class>io.instanto.app.GeneratedTeaVmWorkerMain</app.teavm.main.class>
        <app.teavm.target.file>worker.js</app.teavm.target.file>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-jso-apis</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-classlib</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-tooling</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-extras-slf4j</artifactId>
          <version>${teavm.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-teavm-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/teavm/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>attach-teavm-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>teavm</classifier>
                  <excludes>
                    <!--
                      TeaVM classifier jars should still carry the neutral service manifest for
                      transitive contract discovery, but must not advertise local host wiring
                      from the wrong runtime.
                    -->
                    <exclude>**/GeneratedSartoBootstrapper.class</exclude>
                    <exclude>**/GeneratedServiceBindings.class</exclude>
                    <exclude>META-INF/services/io.instanto.sarto.bootstrap.runtime.SartoBootstrapper</exclude>
                  </excludes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Activated only when TeaVM worker is needed -->
    <profile>
      <id>component-teavm-worker</id>
      <activation>
        <file>
          <exists>target/classes/META-INF/instanto/teavm-worker-enabled</exists>
        </file>
      </activation>
      <properties>
        <app.teavm.main.class>io.instanto.app.GeneratedTeaVmWorkerMain</app.teavm.main.class>
        <app.teavm.target.file>worker.js</app.teavm.target.file>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-cdi-bootstrap</artifactId>
          <version>${sarto-cdi.version}</version>
        </dependency>
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-cdi-teavm-tooling</artifactId>
          <version>${sarto-cdi.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <version>${teavm.version}</version>
            <executions>
              <execution>
                <id>compile-worker</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>compile</goal>
                </goals>
                <configuration>
                  <mainClass>${app.teavm.main.class}</mainClass>
                  <targetDirectory>${project.build.directory}/generated-resources/teavm</targetDirectory>
                  <targetFileName>${app.teavm.target.file}</targetFileName>
                  <minifying>false</minifying>
                  <debugInformationGenerated>true</debugInformationGenerated>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>auto-start-teavm-worker-bundle</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <replaceregexp byline="false"
                                   match="\s*$"
                                   replace="&#10;;if (typeof main === &quot;function&quot;) { main(); } else { throw new Error(&quot;TeaVM worker bootstrap failed: main() not found&quot;); }&#10;">
                      <fileset dir="${project.build.directory}/generated-resources/teavm">
                        <include name="${app.teavm.target.file}"/>
                      </fileset>
                    </replaceregexp>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
