<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>sarto-org-pom</artifactId>
    <version>${revision}</version>
    <relativePath>../sarto-org-pom/pom.xml</relativePath>
  </parent>

  <artifactId>sarto-java-pom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>sarto-java-pom</name>
  <description>Reusable base POMs for io.instanto based projects covering app, service and ui parts</description>

  <properties>
    <!-- TeaVM version — kept here as it is specific to UI/service modules
         and not org-wide -->
    <teavm.version>0.15.0</teavm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-core</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-classlib</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extension-spi</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extension-annotation-processor</artifactId>
        <version>${teavm.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Inherits compiler plugin config from sarto-org-pom;
             override only if a module set needs different settings. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>5.0.0</version>
        <configuration>
          <licenseSets>
            <licenseSet>
              <header>${maven.multiModuleProjectDirectory}/etc/license-header.txt</header>
              <includes><include>**/*.java</include></includes>
              <excludes>
                <exclude>**/target/**</exclude>
                <exclude>**/generated-sources/**</exclude>
                <exclude>**/generated-resources/**</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
          <properties><copyright.year>2026</copyright.year></properties>
          <mapping><java>SLASHSTAR_STYLE</java></mapping>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
