<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Sarto compiles to the browser, so it extends the Instanto TeaVM parent
       rather than the organisation parent directly. TeaVM's version, dependency
       set and plugin pin all arrive from there. -->
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>io.instanto</groupId>
  <artifactId>sarto-org-pom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>sarto-org-pom</name>
  <description>Sarto dependency versions and framework build settings, extending the Instanto organisation parent.</description>

  <!-- ── Role ────────────────────────────────────────────────────────────
       The Sarto organisation layer: one place for every Sarto artifact version, the
       publication destinations, and the licence header. Inherited by the Sarto
       framework and application parents, and by any project that wants the full
       Sarto dependency surface.

       Provides  A version property for each Sarto library; JUnit, slf4j,
                 logback and Mockito versions; BOM imports for graphics, scene,
                 geo, geometry, auth and transactions plus junit-bom; plugin
                 management for Spring Boot, pgpverify, sarto-build, exec and
                 flatten; an active licence header and ${revision} flattening;
                 the github-packages, verify-input-signatures and
                 integration-tests profiles.
       Requires  A revision property, defaulted here to the suite version.
                 copyright.year and license-maven-plugin.version may be
                 overridden per project.
       Not here  TeaVM, which arrives from instanto-teavm-pom above, and
                 formatting and static analysis, which come from
                 instanto-org-pom above that.
  -->
  <url>https://sarto.io</url>

  <!-- ── Organisation ─────────────────────────────────────────────────────── -->

  <organization>
    <name>Sarto</name>
    <url>https://sarto.io</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- ── SCM ──────────────────────────────────────────────────────────────── -->
  <!-- Develop privately, then transfer refined source to Instanto-io.
       Versioned releases run from the Instanto-io checkout on local infrastructure. -->
  <scm>
    <url>https://github.com/cstainton/sarto-poms</url>
        <connection>scm:git:https://github.com/cstainton/sarto-poms.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/cstainton/sarto-poms.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <!-- ── Distribution management ──────────────────────────────────────────── -->
  <!-- Snapshots and releases publish to the Instanto-io organisation's GitHub
       Packages. Credentials come from the local Maven settings. A checkout that
       publishes somewhere else overrides packages.owner on the command line.
       Reading stays open to both owners while artifacts finish moving across. -->

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages — Snapshots</name>
      <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
    </snapshotRepository>
  </distributionManagement>

  <repositories>
    <repository>
      <id>github</id>
      <name>Instanto packages</name>
      <url>https://maven.pkg.github.com/instanto-io/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
      <id>github-development</id>
      <name>Development packages</name>
      <url>https://maven.pkg.github.com/cstainton/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>github</id>
      <name>Instanto build plugins</name>
      <url>https://maven.pkg.github.com/instanto-io/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>github-development</id>
      <name>Development build plugins</name>
      <url>https://maven.pkg.github.com/cstainton/*</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>

  <!-- ── Shared version properties ─────────────────────────────────────────── -->

  <properties>
    <!-- Owner of the GitHub Packages registry this suite publishes to.
         Override on the command line to publish from another checkout. -->
    <packages.owner>instanto-io</packages.owner>

    <!-- ── POM suite version ──────────────────────────────────────────────────
         Single version for the entire reusable POM suite.
         To change the version for a release:
           mvn versions:set-property -Dproperty=revision -DnewValue=0.2.0
         To build/deploy a specific version on the CLI without editing the file:
           mvn install -Drevision=0.2.0-SNAPSHOT
    -->
   <revision>0.1.0-SNAPSHOT</revision>

   <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Logging -->
    <slf4j.version>2.0.18</slf4j.version>
    <logback.version>1.5.38</logback.version>
    <junit.version>6.1.2</junit.version>
    <!-- JUnit 4 is not covered by junit-bom. Keep it at the version junit-vintage-engine
         depends on, so vintage and the TeaVM JUnit runner agree on one JUnit 4. -->
    <junit4.version>4.13.2</junit4.version>
    <mockito.version>5.12.0</mockito.version>
    <sarto-codegen.version>0.1.0-SNAPSHOT</sarto-codegen.version>
    <sarto-cdi.version>0.1.0-SNAPSHOT</sarto-cdi.version>
    <sarto-async.version>0.1.0-SNAPSHOT</sarto-async.version>
    <sarto-auth.version>0.1.0-SNAPSHOT</sarto-auth.version>
    <sarto-rest.version>0.1.0-SNAPSHOT</sarto-rest.version>
    <sarto-soap.version>0.1.0-SNAPSHOT</sarto-soap.version>
    <sarto-codec.version>0.1.0-SNAPSHOT</sarto-codec.version>
    <sarto-relay.version>0.1.0-SNAPSHOT</sarto-relay.version>
    <sarto-edge.version>0.1.0-SNAPSHOT</sarto-edge.version>
    <sarto-persistence.version>0.1.0-SNAPSHOT</sarto-persistence.version>
    <sarto-graphics.version>0.1.0-SNAPSHOT</sarto-graphics.version>
    <sarto-scene.version>0.1.0-SNAPSHOT</sarto-scene.version>
    <sarto-geo.version>0.1.0-SNAPSHOT</sarto-geo.version>
    <sarto-geometry.version>0.1.0-SNAPSHOT</sarto-geometry.version>
    <sarto-events.version>0.1.0-SNAPSHOT</sarto-events.version>
    <sarto-model.version>0.1.0-SNAPSHOT</sarto-model.version>
    <sarto-signals.version>0.1.0-SNAPSHOT</sarto-signals.version>
    <sarto-resources.version>0.1.0-SNAPSHOT</sarto-resources.version>
    <sarto-config.version>0.1.0-SNAPSHOT</sarto-config.version>
    <sarto-transactions.version>0.1.0-SNAPSHOT</sarto-transactions.version>
    <gsdk-widgets-emul.version>0.1.0-SNAPSHOT</gsdk-widgets-emul.version>
    <spring-boot.version>4.1.0</spring-boot.version>

    <!-- Maven plugin versions -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <pgpverify-maven-plugin.version>1.19.1</pgpverify-maven-plugin.version>
    <pgp-keys-map.version>2026.01.20</pgp-keys-map.version>
    <sarto-build-maven-plugin.version>0.1.0-SNAPSHOT</sarto-build-maven-plugin.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <license-maven-plugin.version>5.0.0</license-maven-plugin.version>
    <!-- Overridable by any module that needs a different year in its headers. -->
    <copyright.year>2026</copyright.year>
  </properties>

  <!-- ── Shared dependency management ─────────────────────────────────────── -->

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-graphics-bom</artifactId>
        <version>${sarto-graphics.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-scene-bom</artifactId>
        <version>${sarto-scene.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-geo-bom</artifactId>
        <version>${sarto-geo.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-geometry-bom</artifactId>
        <version>${sarto-geometry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-auth-bom</artifactId>
        <version>${sarto-auth.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-transactions-bom</artifactId>
        <version>${sarto-transactions.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit4.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- ── Plugin management ────────────────────────────────────────────────── -->

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.simplify4u.plugins</groupId>
          <artifactId>pgpverify-maven-plugin</artifactId>
          <version>${pgpverify-maven-plugin.version}</version>
          <configuration>
            <!-- Runs before javac/codegen/TeaVM when the verification profile is active. -->
            <scope>test</scope>
            <verifyPomFiles>true</verifyPomFiles>
            <verifyProvidedDependencies>true</verifyProvidedDependencies>
            <verifyAtypical>true</verifyAtypical>
            <verifyPlugins>true</verifyPlugins>
            <verifyPluginDependencies>true</verifyPluginDependencies>
            <!-- Reactor outputs and snapshots do not yet have release signatures. -->
            <verifyReactorDependencies>false</verifyReactorDependencies>
            <verifySnapshots>false</verifySnapshots>
            <failWeakSignature>true</failWeakSignature>
            <suppressSignatureOkLogging>true</suppressSignatureOkLogging>
            <keysMapLocations>
              <keysMapLocation>/pgp-keys-map.list</keysMapLocation>
            </keysMapLocations>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.simplify4u</groupId>
              <artifactId>pgp-keys-map</artifactId>
              <version>${pgp-keys-map.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-build-maven-plugin</artifactId>
          <version>${sarto-build-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
          <configuration>
            <!-- Resolves only ${revision}, ${sha1}, ${changelist} — leaves the
                 rest of the POM structure intact so dependency graphs stay readable. -->
            <flattenMode>resolveCiFriendliesOnly</flattenMode>
            <flattenDependencyMode>direct</flattenDependencyMode>
            <updatePomFile>true</updatePomFile>
          </configuration>
          <executions>
            <execution>
              <id>flatten</id>
              <phase>process-resources</phase>
              <goals><goal>flatten</goal></goals>
            </execution>
            <execution>
              <id>flatten.clean</id>
              <phase>clean</phase>
              <goals><goal>clean</goal></goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Formatting and SpotBugs are inherited from instanto-org-pom.
         Activate flatten and the licence header for every module that
         inherits from this POM. -->
    <plugins>
                  
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-maven-plugin.version}</version>
        <configuration>
          <licenseSets>
            <licenseSet>
              <header>${maven.multiModuleProjectDirectory}/etc/license-header.txt</header>
              <includes><include>**/*.java</include></includes>
              <excludes>
                <exclude>**/target/**</exclude>
                <exclude>**/generated-sources/**</exclude>
                <exclude>**/generated-resources/**</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
          <properties><copyright.year>${copyright.year}</copyright.year></properties>
          <mapping><java>SLASHSTAR_STYLE</java></mapping>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- ── Profiles ─────────────────────────────────────────────────────────── -->

  <profiles>
    <!-- Reactor-only profiles are declared by higher-level aggregators. Keep a
         no-op declaration here so selected child reactors can activate the
         shared profile without Maven reporting it as unknown. -->
    <profile>
      <id>integration-tests</id>
    </profile>


    <!-- Publish to GitHub Packages -->
    <profile>
      <id>github-packages</id>
      <repositories>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>github</id>
          <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
      <distributionManagement>
        <repository>
          <id>github</id>
          <name>GitHub Packages</name>
          <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
        </repository>
        <snapshotRepository>
          <id>github</id>
          <name>GitHub Packages — Snapshots</name>
          <url>https://maven.pkg.github.com/${packages.owner}/sarto-poms</url>
        </snapshotRepository>
      </distributionManagement>
    </profile>


    <!-- Supply-chain prerequisite for unified JVM/TeaVM artifact work.
         Usage: mvn verify -P verify-input-signatures

         This validates detached OpenPGP signatures before compilation. The
         planned composition-neutral Sarto input-artifact verifier will add
         strict verification of signatures embedded inside dependency JARs. -->
    <profile>
      <id>verify-input-signatures</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.simplify4u.plugins</groupId>
            <artifactId>pgpverify-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-input-openpgp-signatures</id>
                <phase>validate</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.instanto</groupId>
            <artifactId>sarto-build-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-input-jar-contents</id>
                <phase>validate</phase>
                <goals>
                  <goal>verify-input-artifacts</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Release checks and packaging are inherited from instanto-org-pom. -->
  </profiles>

</project>
