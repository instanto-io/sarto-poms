<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>sarto-org-pom</artifactId>
    <version>${revision}</version>
    <relativePath>../sarto-org-pom/pom.xml</relativePath>
  </parent>

  <artifactId>sarto-app-pom</artifactId>
  <packaging>pom</packaging>
  <name>sarto-app-pom</name>
  <description>Neutral build parent for portable applications and their JRE and TeaVM artifacts</description>

  <!-- ── Role ────────────────────────────────────────────────────────────
       Neutral build parent for a portable application. One source tree produces both
       a JRE artifact and a TeaVM artifact; the hosting parents below choose how
       the TeaVM output is packaged and shipped.

       Provides  The app.* properties that name the main classes, output
                 directories and bundle files; the app-jre and app-teavm
                 profiles, with Swing and JavaFX variants; the JavaFX platform
                 profiles for each supported architecture; plugin management for
                 teavm-maven-plugin, javafx-maven-plugin and the jar plugin; the
                 CDI bean index aggregation step.
       Requires  The Sarto version properties from sarto-org-pom. An application
                 overrides app.jvm.main.class and app.teavm.main.class.
       Not here  A hosting target. Inherit sarto-app-browser-pom,
                 sarto-app-cloudflare-pom or sarto-app-tomcat-pom for that.
  -->
  <properties>
    <javafx.version>26.0.1</javafx.version>
    <javafx.platform>mac-aarch64</javafx.platform>
    <javafx.build.id>${javafx.platform}</javafx.build.id>
    <teavm.bundle.skip>true</teavm.bundle.skip>
    <app.jvm.java>/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home/bin/java</app.jvm.java>
    <app.jvm.main.class>io.instanto.sarto.application.bootstrap.JvmLauncher</app.jvm.main.class>
    <app.teavm.main.class>io.instanto.app.GeneratedTeaVmMain</app.teavm.main.class>
    <app.teavm.target.directory>${project.build.directory}/generated-resources/teavm</app.teavm.target.directory>
    <app.teavm.target.file>app.js</app.teavm.target.file>
    <app.teavm.phase>none</app.teavm.phase>
    <app.teavm.bundle.file>${project.build.directory}/${project.artifactId}-${project.version}-web.zip</app.teavm.bundle.file>
    <teavm.skip>true</teavm.skip>
    <!--
      Local dev server port used by the TeaVM app serve goal.
      Override with -Dapp.server.port=NNNN.
    -->
    <app.server.port>8080</app.server.port>
    <app.enforcer.skip.jre.classifier.ban>false</app.enforcer.skip.jre.classifier.ban>
    <app.enforcer.skip.teavm.classifier.ban>false</app.enforcer.skip.teavm.classifier.ban>
  </properties>
  
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-framework-pom</artifactId>
        <version>${revision}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-application</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-cdi-bootstrap</artifactId>
      <version>${sarto-cdi.version}</version>
    </dependency>
    <!-- Maven 3 reactor edge; javac activation remains on annotationProcessorPaths. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-annotation-processor</artifactId>
      <version>${revision}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <version>4.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-transactions</artifactId>
      <version>${sarto-transactions.version}</version>
    </dependency>
    <!-- Reactor edge for the BCE activated on the processor path below. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>sarto-transactions-extension</artifactId>
      <version>${sarto-transactions.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Final applications must compose CDI bean indexes published by their
           framework and library dependencies before javac validates the graph. -->
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>sarto-cdi-maven-plugin</artifactId>
        <version>${sarto-cdi.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>sarto-annotation-processor</artifactId>
              <version>${revision}</version>
            </path>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>sarto-cdi-annotation-processor</artifactId>
              <version>${sarto-cdi.version}</version>
            </path>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>sarto-transactions-extension</artifactId>
              <version>${sarto-transactions.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>0.0.8</version>
          <configuration>
            <mainClass>${app.jvm.main.class}</mainClass>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-maven-plugin</artifactId>
          <version>${teavm.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.teavm</groupId>
              <artifactId>teavm-extras-slf4j</artifactId>
              <version>${teavm.version}</version>
            </dependency>
            <dependency>
              <groupId>io.instanto</groupId>
              <artifactId>sarto-onejar-plugin</artifactId>
              <version>${sarto-onejar.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <mainClass>${app.teavm.main.class}</mainClass>
            <targetType>JAVASCRIPT</targetType>
            <targetDirectory>${app.teavm.target.directory}</targetDirectory>
            <targetFileName>${app.teavm.target.file}</targetFileName>
            <transformers>
              <transformer>io.instanto.sarto.onejar.teavm.JvmTargetPruningTransformer</transformer>
            </transformers>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>javafx-mac-arm</id>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
        <javafx.build.id>mac-arm</javafx.build.id>
      </properties>
    </profile>
    <profile>
      <id>javafx-mac-x64</id>
      <properties>
        <javafx.platform>mac</javafx.platform>
        <javafx.build.id>mac-x64</javafx.build.id>
      </properties>
    </profile>
    <profile>
      <id>javafx-linux-x64</id>
      <activation>
        <os>
          <family>unix</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <javafx.platform>linux</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>javafx-linux-arm</id>
      <properties>
        <javafx.platform>linux-aarch64</javafx.platform>
        <javafx.build.id>linux-arm</javafx.build.id>
      </properties>
    </profile>
    <profile>
      <id>javafx-win-x64</id>
      <properties>
        <javafx.platform>win</javafx.platform>
        <javafx.build.id>win-x64</javafx.build.id>
      </properties>
    </profile>
    <profile>
      <id>javafx-win-arm</id>
      <properties>
        <javafx.platform>win</javafx.platform>
        <javafx.build.id>win-arm</javafx.build.id>
      </properties>
    </profile>

    <profile>
      <id>app-jre</id>
      <activation>
        <file><exists>src/jre/java</exists></file>
      </activation>
      <dependencies>
        <!-- The executable JVM variant owns CDI integration. Optional facilities
             such as REST remain explicit host capabilities. -->
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-cdi-bootstrap</artifactId>
        </dependency>
        <dependency>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>ban-teavm-classifier-in-jre-app</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <skip>${app.enforcer.skip.jre.classifier.ban}</skip>
                  <rules>
                    <bannedDependencies>
                      <searchTransitive>true</searchTransitive>
                      <excludes>
                        <exclude>*:*:*:*:*:teavm</exclude>
                      </excludes>
                      <message>JRE app builds must not resolve TeaVM-classified artifacts transitively. Depend on neutral or jre artifacts instead.</message>
                    </bannedDependencies>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-app-jre-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/jre/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>attach-app-jre-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>jre</classifier>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <executable>${app.jvm.java}</executable>
              <mainClass>${app.jvm.main.class}</mainClass>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>app-teavm</id>
      <properties>
        <app.enforcer.skip.jre.classifier.ban>true</app.enforcer.skip.jre.classifier.ban>
        <app.teavm.phase>prepare-package</app.teavm.phase>
        <teavm.bundle.skip>false</teavm.bundle.skip>
        <teavm.skip>false</teavm.skip>
      </properties>
      <activation>
        <file><exists>src/teavm/java</exists></file>
      </activation>
      <dependencies>
        <!-- Select TeaVM CDI integration only for the executable TeaVM variant. -->
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-cdi-bootstrap</artifactId>
          <version>${sarto-cdi.version}</version>
        </dependency>
        <!-- Supplies TeaVM-compatible java.util.concurrent completion-stage classes used
             by Jakarta CDI event delivery and Sarto's portable async contracts. -->
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-async</artifactId>
        </dependency>
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>sarto-transport-stomp</artifactId>
          <version>${revision}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-jso</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-jso-apis</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-core</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-classlib</artifactId>
          <version>${teavm.version}</version>
        </dependency>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
          <version>${slf4j.version}</version>
        </dependency>
        <dependency>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-extras-slf4j</artifactId>
          <version>${teavm.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>ban-jre-classifier-in-teavm-app</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <skip>${app.enforcer.skip.teavm.classifier.ban}</skip>
                  <rules>
                    <bannedDependencies>
                      <searchTransitive>true</searchTransitive>
                      <excludes>
                        <exclude>*:*:*:*:*:jre</exclude>
                      </excludes>
                      <message>TeaVM app builds must not resolve JRE-classified artifacts transitively. Depend on neutral or teavm artifacts instead.</message>
                    </bannedDependencies>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-app-teavm-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/teavm/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>attach-teavm-web-zip</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <skipAttach>${teavm.skip}</skipAttach>
                  <artifacts>
                    <artifact>
                      <file>${app.teavm.bundle.file}</file>
                      <type>zip</type>
                      <classifier>web</classifier>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>attach-app-teavm-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>teavm</classifier>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>app-teavm-main</id>
                <phase>${app.teavm.phase}</phase>
                <goals>
                  <goal>compile</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>copy-webapp-resources</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <outputDirectory>${app.teavm.target.directory}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>src/main/webapp</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            Local dev server — serves the compiled TeaVM output directory.
            Uses the JDK's built-in simple web server (Java 18+, jdk.httpserver module).
            Usage (after mvn package):  mvn exec:exec
            Override port:              mvn exec:exec -Dapp.server.port=9090
            No external tools required.
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <executable>${app.jvm.java}</executable>
              <!--
                commandlineArgs is used instead of <arguments> to work around
                exec-maven-plugin silently dropping pure-numeric argument values.
                Maven resolves properties before the plugin splits on whitespace.
              -->
              <commandlineArgs>-m jdk.httpserver -p ${app.server.port} -d ${app.teavm.target.directory}</commandlineArgs>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>auto-start-teavm-worker-bundles</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <target>
                    <replaceregexp byline="false"
                                   match="\s*$"
                                   replace="&#10;;if (typeof main === &quot;function&quot;) { main(); } else { throw new Error(&quot;TeaVM worker bootstrap failed: main() not found&quot;); }&#10;">
                      <fileset dir="${app.teavm.target.directory}">
                        <include name="worker.js"/>
                        <include name="*-worker.js"/>
                        <exclude name="app.js"/>
                      </fileset>
                    </replaceregexp>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>zip-web-deploy-bundle</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${teavm.skip}</skip>
                  <target>
                    <zip destfile="${app.teavm.bundle.file}"
                         basedir="${app.teavm.target.directory}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
            <configuration>
              <skip>${teavm.skip}</skip>
            </configuration>
          </plugin>

        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Swing desktop app.
        Run:     mvn exec:java   (launches in-process; fast for development)
        Fat jar: mvn package assembly:single  →  java -jar target/*-all.jar
        Both are wired via the exec-maven-plugin configured in the app-jre profile
        (auto-activated by src/jre/java) and the assembly plugin below.
      -->
      <id>app-jre-swing</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-assembly-plugin</artifactId>
              <version>3.8.0</version>
              <configuration>
                <archive>
                  <manifest>
                    <mainClass>${app.jvm.main.class}</mainClass>
                  </manifest>
                </archive>
                <descriptorRefs>
                  <descriptorRef>jar-with-dependencies</descriptorRef>
                </descriptorRefs>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>

    <profile>
      <!--
        JavaFX desktop app.
        Build:    mvn package -Papp-jre-fx
        Run:      mvn javafx:run  (compiles + launches directly; handles module-path)
        Fat jar:  mvn package exec:exec  (launches the assembled -all.jar)
      -->
      <id>app-jre-fx</id>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>${javafx.platform}</classifier>
        </dependency>
      </dependencies>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-maven-plugin</artifactId>
              <version>0.0.8</version>
              <configuration>
                <mainClass>${app.jvm.main.class}</mainClass>
              </configuration>
            </plugin>
            <!--
              exec:exec launches the assembled fat jar produced by maven-assembly-plugin.
              The jar includes all dependencies (including the platform JavaFX natives)
              and declares the main-class in its manifest, so a plain java -jar works.
              Use this when you want a single-command launch after mvn package.
            -->
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>exec-maven-plugin</artifactId>
              <version>3.6.3</version>
              <configuration>
                <executable>${app.jvm.java}</executable>
                <arguments>
                  <argument>-jar</argument>
                  <argument>${project.build.directory}/${project.artifactId}-${project.version}-${javafx.build.id}-all.jar</argument>
                </arguments>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-assembly-plugin</artifactId>
              <version>3.8.0</version>
              <configuration>
                <finalName>${project.artifactId}-${project.version}-${javafx.build.id}-all</finalName>
                <appendAssemblyId>false</appendAssemblyId>
                <archive>
                  <manifest>
                    <mainClass>${app.jvm.main.class}</mainClass>
                  </manifest>
                </archive>
                <descriptorRefs>
                  <descriptorRef>jar-with-dependencies</descriptorRef>
                </descriptorRefs>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
